{
  "manifest_version": 2,
  "name": "LeetFlow Sync",
  "version": "0.6.1",
  "description": "Sync accepted LeetCode solutions to a GitHub repository and keep a review-friendly archive.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "scripts": ["background.firefox.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "LeetFlow Sync",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "applications": {
    "gecko": {
      "id": "leetflow-sync@example.invalid",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*", "https://leetcode.cn/problems/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["inpage.js"]
}
